{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/youtube-metadata", "dest": "/api/youtube-metadata.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
